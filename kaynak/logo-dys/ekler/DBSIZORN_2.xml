End If]]><Zaman>1</Zaman><EventType>0</EventType></Object><Object><Name>btnSil</Name><Event>OnClick</Event><![CDATA[prmResult = NETSISCORE.NetLibWin32.ShowNetsisMesaj("Kay?t silinecek, Emin misiniz?", 8)
