Dim DBNOKTASIZ
Dim qry1
'Temelsetten NDI
Set qry1 = Kernel.Values("TS_CORE").NetLibDB.GetNewQuery
Str = "SELECT db_name() SIRKET"
qry1.RECSQL(Str)
DB = qry1.FieldByName("SIRKET").AsString & ".."
DBNOKTASIZ = qry1.FieldByName("SIRKET").AsString & "."
qry1.Close

Function PadString(pString,pLength,pChar,pSide)
  strString = pString
  strPadding = String(pLength,pChar)
  If lcase(pSide)="left" then
    strString = strPadding & strString
    strString = Right(strString,pLength)
  else
    strString = strString & strPadding
    strString = Left(strString,pLength)
  End if
  PadString = strString
End Function


Function TarihFormatla(tarih,ayirac)
  strDay = Cstr(DatePart("d", tarih))
  strMonth = Cstr(DatePart("m", tarih))
  strYear = Cstr(DatePart("yyyy", tarih))
  strDay=PadString(strDay,2,"0","left")
  strMonth=PadString(strMonth,2,"0","left")
  TarihFormatla = strYear + ayirac + strMonth + ayirac + strDay
End Function

Function TarihGecerli(strtarih)
  dim sonuc
  sonuc=True
  err.clear
  on error resume next
    tarih=CDate(strtarih)
  if err.number>0 then
    sonuc=False
  end if
  TarihGecerli=sonuc
End Function]]><Zaman>1</Zaman><EventType>0</EventType></Object><Object><Name>btnKaydet</Name><Event>OnClick</Event><![CDATA[if edtSeri.Text="" then
