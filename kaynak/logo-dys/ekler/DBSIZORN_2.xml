rs>ssBoth</ScrollBars><DbConnectionCode>DBEMAS</DbConnectionCode><GridSql>SELECT ID,T1.SERIKODU,DEMIRBAS_ADI,T1.SICILNO,AD_SOYAD,BASTAR,BITTAR,ACIKLAMA FROM EMAS..TBLDEMZIMMET T1
